#!/bin/sh
# Graphical session for the persistent SD root (ticket 213). Lives at
# /usr/local/sbin/t6040-startx on the card, run from inittab as a ::once: entry.
#
# Deliberately does NOT use startx/xinit: xinit exits immediately in this
# configuration and takes X down with it, even with a valid hostname. Launching
# Xorg and i3 directly is the path proven live 2026-08-03 (i3 4.24 on the native
# 3024x1867 panel).
#
# hostname FIRST: as a ::once: entry this races ahead of openrc's hostname
# service, and xauth then builds the display name "(none):0", fails, and i3
# cannot authenticate -- X exits and it looks like an X bug rather than a
# boot-ordering bug.
hostname -F /etc/hostname 2>/dev/null
n=0
while [ ! -e /dev/dri/card0 ] && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
[ -e /dev/dri/card0 ] || exit 0
export HOME=/root DISPLAY=:0

# Norwegian layout for X, by CONFIG rather than only by command: setxkbmap below
# was silenced with 2>/dev/null, so if the binary is absent the layout silently
# stays US -- and a US map makes |, \, @, $, [], {} and the Norwegian letters
# wrong or unreachable. Mandatory per AGENTS.md; the console keymap is loaded
# separately by the initramfs and does not cover X.
if [ ! -f /etc/X11/xorg.conf.d/00-keyboard.conf ]; then
    mkdir -p /etc/X11/xorg.conf.d
    cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<'XKB'
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "no"
EndSection
XKB
    echo "wrote xorg.conf.d/00-keyboard.conf (XkbLayout no)" >/var/log/wallace-keymap.log
fi

/usr/libexec/Xorg :0 -logfile /var/log/xorg.log -noreset vt1 >/var/log/xorg-start.log 2>&1 &
n=0
while [ ! -e /tmp/.X11-unix/X0 ] && [ "$n" -lt 20 ]; do sleep 1; n=$((n + 1)); done
# The X0 socket existing does NOT mean X accepts connections yet: this ran too
# early and logged 'Cannot open display ":0"' -> 'setxkbmap no FAILED', leaving a
# US layout on an otherwise working desktop (2026-08-04). XAUTHORITY must also be
# explicit here -- it is set for i3 below, but setxkbmap ran without it.
# So: retry until the server actually answers, and report the outcome either way.
export XAUTHORITY="${XAUTHORITY:-/root/.Xauthority}"
if command -v setxkbmap >/dev/null 2>&1; then
    n=0
    while [ "$n" -lt 20 ]; do
        if setxkbmap no >>/var/log/wallace-keymap.log 2>&1; then
            echo "setxkbmap no OK after ${n}s" >>/var/log/wallace-keymap.log
            break
        fi
        n=$((n + 1))
        sleep 1
    done
    [ "$n" -lt 20 ] || echo "setxkbmap no FAILED after ${n}s" >>/var/log/wallace-keymap.log
else
    echo "setxkbmap absent; relying on xorg.conf.d" >>/var/log/wallace-keymap.log
fi
exec /usr/bin/i3 >/var/log/i3.log 2>&1
