#!/bin/busybox sh
# Storage-disabled maxcpus=2 reporter for the DockChannel early-console
# diagnostic. The regular UART mailbox driver is blacklisted for this boot, so
# write the bounded report to /dev/kmsg; keep_bootcon forwards it over the
# polled DockChannel TX FIFO without a second owner of that FIFO.
/bin/busybox mount -t proc none /proc
/bin/busybox mount -t sysfs none /sys
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null

BB=/bin/busybox

if [ -c /dev/watchdog0 ]; then
    $BB watchdog -T 30 -t 10 /dev/watchdog0 &
fi

report()
{
    echo "T6040_SMP_EARLY_REPORT_BEGIN"
    echo "cmdline: $($BB cat /proc/cmdline)"
    for f in possible present online; do
        echo "cpu_$f: $($BB cat /sys/devices/system/cpu/$f 2>/dev/null)"
    done
    n_online=$($BB grep -c '^processor' /proc/cpuinfo)
    echo "processor_count: $n_online"
    $BB grep -E '^processor|^CPU implementer|^CPU part' /proc/cpuinfo
    if [ "$n_online" -ge 2 ]; then
        $BB taskset -c 1 $BB awk \
            '{ print "cpu1_task_psr: " $39 }' /proc/self/stat \
            || echo "cpu1_task: failed"
        echo "T6040_SMP_EARLY_RESULT_PASS"
    else
        echo "T6040_SMP_EARLY_RESULT_FAIL"
    fi
    $BB dmesg | $BB grep -Ei \
        'smp|cpu[0-9]|spin-table|bringup|boot.*cpu|psci|wfe|failed to' |
        $BB tail -40
    echo "T6040_SMP_EARLY_REPORT_END"
}

if [ -c /dev/kmsg ]; then
    report >/dev/kmsg 2>&1
else
    report
fi

while :; do $BB sleep 3600; done
