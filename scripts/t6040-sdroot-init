#!/bin/busybox sh
# Fail-closed /init for the ticket-204 SD root.
#
# SD64 remains one exFAT partition. wallace-root.img is a 6 GiB ext4 image
# used as /. A small tmpfs survives switch_root so a SIGQUIT restart action
# can pivot away from the loop root, detach it, and unmount exFAT cleanly.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
BB=/bin/busybox
PART=/dev/mmcblk0p1
PCI_DEV=/sys/bus/pci/devices/0000:02:00.0
ROOT_UUID=4c41b99c-7747-4688-85a5-397bc5d784a2
ROOT_BYTES=6442450944
LOOP=""

say() {
    echo "sdroot: $*" >/dev/kmsg 2>/dev/null
    echo "sdroot: $*"
}

# Everything the rescue shell wants to know about why the card is absent.
# Printed before dropping the shell, because the shell may be unusable.
diag() {
    say "--- diagnostics ---"
    say "partitions:"; "$BB" cat /proc/partitions 2>/dev/null
    for h in /sys/class/mmc_host/*; do
        [ -d "$h" ] || continue
        say "mmc_host $("$BB" basename "$h"): slots=$("$BB" ls "$h" 2>/dev/null | "$BB" tr '\n' ' ')"
    done
    say "block devices: $("$BB" ls /sys/class/block 2>/dev/null | "$BB" tr '\n' ' ')"
    say "pci devices: $("$BB" ls /sys/bus/pci/devices 2>/dev/null | "$BB" tr '\n' ' ')"
    # Is there a keyboard at all? A rescue shell that ignores keys is usually
    # missing an input device, not a controlling terminal.
    say "input devices: $("$BB" ls /dev/input 2>/dev/null | "$BB" tr '\n' ' ')"
    for i in /sys/class/input/input*; do
        [ -r "$i/name" ] || continue
        say "  $("$BB" basename "$i"): $("$BB" cat "$i/name" 2>/dev/null)"
    done
    say "--- end diagnostics ---"
}

# The rescue shell must be usable from the built-in keyboard, which means a
# real controlling terminal. Inheriting init's stdin gives /dev/console with
# no ctty -- busybox then prints "can't access tty: job control turned off"
# and ignores every keypress. setsid -c on a VT fixes both.
rescue_shell() {
    # apple-pmgr-pwrstate emits a continuous sync_state() stream for seconds
    # after init starts; at the default loglevel it scrolls the prompt away and
    # makes the shell look dead. Console loglevel 1 keeps the VT usable while
    # /dev/kmsg (and thus the serial log) still records everything.
    echo 1 >/proc/sys/kernel/printk 2>/dev/null || true
    for t in /dev/tty1 /dev/tty0 /dev/console; do
        [ -c "$t" ] || continue
        say "rescue shell on $t (keyboard should work here)"
        setsid -c "$BB" sh -i <"$t" >"$t" 2>&1 && return
        "$BB" setsid -c "$BB" sh -i <"$t" >"$t" 2>&1 && return
    done
    say "no usable VT found; falling back to an inherited-stdin shell"
    exec "$BB" sh -i
}

stop() {
    say "STOP: $*"
    say "No further card writes will be attempted; use the diagnostic shell."
    diag
    rescue_shell
    exec "$BB" sh -i
}

mount_core() {
    "$BB" mount -t proc none /proc || return 1
    "$BB" mount -t sysfs none /sys || return 1
    "$BB" mount -t devtmpfs none /dev || return 1
}

cleanup_root() {
    "$BB" sync
    "$BB" umount /newroot/mnt/sd 2>/dev/null || true
    "$BB" umount /newroot/dev 2>/dev/null || true
    "$BB" umount /newroot/proc 2>/dev/null || true
    "$BB" umount /newroot/sys 2>/dev/null || true
    "$BB" umount /newroot/run/initramfs/sd 2>/dev/null || true
    "$BB" umount /newroot/run/initramfs 2>/dev/null || true
    "$BB" umount /newroot 2>/dev/null || true
    [ -z "$LOOP" ] || "$BB" losetup -d "$LOOP" 2>/dev/null || true
    "$BB" umount /sd 2>/dev/null || true
}

mount_core || stop "cannot mount proc, sysfs, and devtmpfs"

# Norwegian console keymap, loaded before ANY shell can be spawned -- including
# the rescue shell reached by stop(). This is a hard project requirement: the
# machine has a Norwegian keyboard, and under the default US map |, \, @, $,
# [], {} and the Norwegian letters are wrong or unreachable.
#
# The keymap is kernel state on the VT, so loading it here also covers the
# console after switch_root; only X needs its own XkbLayout.
# busybox provides loadkmap (binary keymap on stdin), not kbd's loadkeys.
if [ -f /etc/wallace-no.bmap ]; then
    if "$BB" loadkmap < /etc/wallace-no.bmap 2>/dev/null; then
        say "Norwegian console keymap loaded"
    else
        say "WARNING: loadkmap failed; console stays US"
    fi
else
    say "WARNING: /etc/wallace-no.bmap missing; console stays US"
fi

# PCIe is enumerated asynchronously and /init can run extremely early -- on a
# fast rootfs unpack it has been observed at 0.20s, long before apple-pcie has
# brought up port 2 or sdhci-pci has bound. These gates therefore have to WAIT,
# not sample once: an unwaited check reports "absent" when it means "not yet",
# which is how this failed after a hard reboot with a perfectly good card.
n=0
while [ ! -d "$PCI_DEV" ] && [ "$n" -lt 25 ]; do
    "$BB" sleep 1
    n=$((n + 1))
done
[ -d "$PCI_DEV" ] || stop "GL9755 0000:02:00.0 is absent after ${n}s"
say "GL9755 present after ${n}s"

[ "$("$BB" cat "$PCI_DEV/vendor" 2>/dev/null)" = 0x17a0 ] || stop "wrong PCI vendor"
[ "$("$BB" cat "$PCI_DEV/device" 2>/dev/null)" = 0x9755 ] || stop "wrong PCI device"

n=0
while [ ! -L "$PCI_DEV/driver" ] && [ "$n" -lt 25 ]; do
    "$BB" sleep 1
    n=$((n + 1))
done
[ -L "$PCI_DEV/driver" ] || stop "GL9755 has no bound driver after ${n}s"
say "sdhci-pci bound after ${n}s"
[ "$("$BB" basename "$("$BB" readlink "$PCI_DEV/driver")")" = sdhci-pci ] || \
    stop "GL9755 is not bound to sdhci-pci"
[ -L "$PCI_DEV/iommu_group" ] || stop "GL9755 lacks a DART/IOMMU group"

# The PCIe MMC host appears asynchronously.
n=0
while [ ! -b "$PART" ] && [ "$n" -lt 30 ]; do
    "$BB" sleep 1
    n=$((n + 1))
done
[ -b "$PART" ] || stop "$PART did not appear after ${n}s"
[ -e /sys/class/block/mmcblk0/device ] || stop "mmcblk0 sysfs identity is missing"
PCI_PATH=$("$BB" readlink -f "$PCI_DEV" 2>/dev/null || true)
MMC_PATH=$("$BB" readlink -f /sys/class/block/mmcblk0/device 2>/dev/null || true)
[ -n "$PCI_PATH" ] && [ -n "$MMC_PATH" ] || stop "cannot resolve GL9755/MMC sysfs ancestry"
case "$MMC_PATH" in
    "$PCI_PATH"/*) ;;
    *) stop "mmcblk0 is not a child of the reviewed GL9755 controller" ;;
esac

# Resolve the maintainer-provided label and require that it names the expected
# SD partition. The explicit exFAT mount below is the filesystem-type gate.
LABEL_DEV=$("$BB" findfs LABEL=SD64 2>/dev/null || true)
[ "$LABEL_DEV" = "$PART" ] || stop "LABEL=SD64 resolved to '${LABEL_DEV:-nothing}', expected $PART"

# exFAT VolumeFlags is the little-endian word at byte 106; bit 1 means dirty.
# Refuse RW mounting after a panic or unclean shutdown.
read_flags() {
    _f=$("$BB" dd if="$PART" bs=1 skip=106 count=2 2>/dev/null | "$BB" od -An -tu2)
    echo "${_f##* }"
}

FLAGS=$(read_flags)
[ -n "$FLAGS" ] || stop "could not read exFAT VolumeFlags"

# Repair with a real filesystem check rather than clearing the dirty bit: an
# unclean shutdown mid-write can leave genuine metadata inconsistency, and
# masking the flag would mount a container we already know is suspect.
# CJ approved carrying fsck.exfat in the initramfs for exactly this (2026-08-03).
if [ $((FLAGS & 2)) -ne 0 ]; then
    say "SD64 exFAT is dirty (VolumeFlags=$FLAGS); running fsck.exfat"
    [ -x /sbin/fsck.exfat ] || stop "dirty exFAT but /sbin/fsck.exfat is missing"
    /sbin/fsck.exfat -y "$PART"
    rc=$?
    say "fsck.exfat exit=$rc"
    FLAGS=$(read_flags)
    [ -n "$FLAGS" ] || stop "could not re-read exFAT VolumeFlags after fsck"
    say "VolumeFlags after fsck=$FLAGS"
fi

# The gate is unconditional: whether the volume was clean to begin with or was
# just repaired, it must be clean HERE or we do not mount it read-write.
[ $((FLAGS & 2)) -eq 0 ] || stop "SD64 exFAT still dirty (VolumeFlags=$FLAGS) after repair; do not use RW"

"$BB" mkdir -p /sd /newroot
"$BB" mount -t exfat -o ro "$PART" /sd || stop "SD64 did not mount as exFAT read-only"
IMG=/sd/wallace-root.img
if [ ! -f "$IMG" ]; then
    "$BB" umount /sd 2>/dev/null || true
    stop "$IMG is missing"
fi
IMG_BYTES=$("$BB" stat -c %s "$IMG" 2>/dev/null || true)
if [ "$IMG_BYTES" != "$ROOT_BYTES" ]; then
    "$BB" umount /sd 2>/dev/null || true
    stop "$IMG has size '${IMG_BYTES:-unknown}', expected $ROOT_BYTES"
fi

LOOP=$("$BB" losetup -f 2>/dev/null || true)
[ -n "$LOOP" ] || { "$BB" umount /sd 2>/dev/null || true; stop "no free loop device"; }
"$BB" losetup -r "$LOOP" "$IMG" || { "$BB" umount /sd 2>/dev/null || true; stop "cannot attach $IMG read-only"; }

UUID_DEV=$("$BB" findfs "UUID=$ROOT_UUID" 2>/dev/null || true)
if [ "$UUID_DEV" != "$LOOP" ]; then
    "$BB" losetup -d "$LOOP" 2>/dev/null || true
    "$BB" umount /sd 2>/dev/null || true
    stop "root UUID resolved to '${UUID_DEV:-nothing}', expected $LOOP"
fi

# ext4 s_state is the little-endian word at superblock offset 58. Require
# EXT4_VALID_FS before allowing a writable root; do not replay a journal here.
STATE=$("$BB" dd if="$LOOP" bs=1 skip=1082 count=2 2>/dev/null | "$BB" od -An -tu2)
STATE=${STATE##* }
[ -n "$STATE" ] || { cleanup_root; stop "could not read ext4 filesystem state"; }
[ "$STATE" -eq 1 ] || { cleanup_root; stop "ext4 root is not clean (s_state=$STATE); inspect/repair before RW use"; }

# The complete nested identity has now been proven without a write. Tear down
# the read-only view before reopening the same reviewed objects read-write.
"$BB" losetup -d "$LOOP" || { cleanup_root; stop "cannot detach read-only $LOOP"; }
LOOP=""
"$BB" umount /sd || stop "SD64 read-only identity mount would not unmount"
"$BB" mount -t exfat -o rw "$PART" /sd || stop "SD64 did not mount as exFAT read-write"
LOOP=$("$BB" losetup -f 2>/dev/null || true)
[ -n "$LOOP" ] || { "$BB" umount /sd 2>/dev/null || true; stop "no free loop device"; }
"$BB" losetup "$LOOP" "$IMG" || { "$BB" umount /sd 2>/dev/null || true; stop "cannot attach $IMG"; }
UUID_DEV=$("$BB" findfs "UUID=$ROOT_UUID" 2>/dev/null || true)
[ "$UUID_DEV" = "$LOOP" ] || { cleanup_root; stop "ext4 UUID changed after read-write attach"; }

"$BB" mount -t ext4 -o rw "$LOOP" /newroot || { cleanup_root; stop "cannot mount the ext4 root"; }

for required in /sbin/init /bin/busybox /etc/inittab \
    /usr/local/sbin/t6040-sdroot-early-console \
    /usr/local/sbin/t6040-sdroot-openrc \
    /usr/local/sbin/t6040-sdroot-powerctl; do
    [ -s "/newroot$required" ] || { cleanup_root; stop "new root is missing $required"; }
done

# Preserve only the shutdown tools. The original initramfs root is discarded
# by switch_root; this tmpfs remains mounted inside the real root.
"$BB" mkdir -p /newroot/run/initramfs/bin /newroot/run/initramfs/oldroot \
    /newroot/run/initramfs/sd /newroot/mnt/sd
"$BB" mount -t tmpfs -o mode=0755,size=4m none /newroot/run/initramfs \
    || { cleanup_root; stop "cannot mount the shutdown tmpfs"; }
"$BB" mkdir -p /newroot/run/initramfs/bin /newroot/run/initramfs/oldroot \
    /newroot/run/initramfs/sd
"$BB" cp /bin/busybox /newroot/run/initramfs/bin/busybox \
    || { cleanup_root; stop "cannot preserve busybox for shutdown"; }
"$BB" cp /shutdown /newroot/run/initramfs/shutdown \
    || { cleanup_root; stop "cannot preserve the shutdown program"; }
echo "$LOOP" >/newroot/run/initramfs/loopdev
echo reboot >/newroot/run/initramfs/action

# Keep the exFAT mount outside the loop-root subtree. A bind mount exposes it
# as /mnt/sd during normal operation; shutdown removes that view before pivot.
"$BB" mount --move /sd /newroot/run/initramfs/sd \
    || { cleanup_root; stop "cannot move SD64 under the shutdown tmpfs"; }
"$BB" mount --bind /newroot/run/initramfs/sd /newroot/mnt/sd \
    || { cleanup_root; stop "cannot expose SD64 at /mnt/sd"; }

"$BB" mkdir -p /newroot/dev /newroot/proc /newroot/sys
"$BB" mount -t devtmpfs none /newroot/dev || { cleanup_root; stop "newroot devtmpfs failed"; }
"$BB" mount -t proc none /newroot/proc || { cleanup_root; stop "newroot proc failed"; }
"$BB" mount -t sysfs none /newroot/sys || { cleanup_root; stop "newroot sysfs failed"; }
[ -c /newroot/dev/ttydc0 ] || { cleanup_root; stop "newroot ttydc0 is missing"; }

say "switching to the verified SD root"
exec "$BB" switch_root /newroot /sbin/init
