#!/bin/sh
# SPDX-License-Identifier: MIT
# Direct-ext4 root shutdown gate. BusyBox init waits for ::shutdown to finish;
# never return to it with a writable root after a failed OpenRC shutdown.
BB=/bin/busybox
stop() {
    echo "usb-root: STOP shutdown: $*; root must be read-only before poweroff" >/dev/console
    # Keep PID1 waiting. A shell is allowed only with the pinned Norwegian map.
    if printf '%s  %s\n' \
        606ecd98f83b72983f3cd35976df939dc9c7187283703736a81e89b65aee85a8 \
        /etc/wallace-no.bmap | $BB sha256sum -c - >/dev/null 2>&1 &&
        $BB loadkmap </etc/wallace-no.bmap; then
        $BB sh -i </dev/console >/dev/console 2>&1
    fi
    while :; do $BB sleep 3600; done
}
[ "$#" -eq 1 ] && [ "$1" = shutdown ] || exit 2
/sbin/openrc shutdown || stop "OpenRC returned failure"
$BB sync || stop "sync failed"
# mount-ro can be skipped when OpenRC detects a container, and service failure
# must not be hidden by the runlevel's aggregate exit status. Check the actual
# root mount after an explicit remount, including the expected fs type.
$BB mount -o remount,ro / || stop "root remount failed"
$BB awk '$5 == "/" { n++; split($6,a,","); ro=0; for(i in a) if(a[i]=="ro") ro=1;
    ext4=0; for(i=7;i<=NF;i++) if($i=="-" && $(i+1)=="ext4") ext4=1;
    ok=ro && ext4 } END { exit !(n==1 && ok) }' /proc/self/mountinfo ||
    stop "root is not a single read-only ext4 mount"
echo "usb-root: shutdown root read-only verified" >/dev/console
