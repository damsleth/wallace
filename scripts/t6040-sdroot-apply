#!/usr/bin/env bash
# Install the reviewed ticket-204 userspace configuration through the bootstrap
# image. The payload is a tar stream, so script input and file content cannot
# consume each other.
set -euo pipefail

TARGET=${1:?usage: t6040-sdroot-apply root@HOST}
ROOT=$(cd "$(dirname "$0")/.." && pwd)

bsdtar -cf - -C "$ROOT/scripts" \
    t6040-sdroot-apply-remote \
    t6040-sdroot-inittab \
    t6040-sdroot-early-console \
    t6040-sdroot-openrc \
    t6040-sdroot-powerctl |
ssh "$TARGET" '
    set -eu
    payload=/tmp/t6040-sdroot-config.$$
    mkdir -p "$payload"
    tar -xf - -C "$payload"
    exec /bin/sh "$payload/t6040-sdroot-apply-remote" "$payload"
'
