#!/bin/busybox sh
# One-shot installer for the NVMe daily root (ticket 5005).
#
# Writes the host-built root image (16 GiB ext4, UUID 988d97b4, carried in
# this initramfs as /wallace-root.img.xz with its raw sha256) onto the pinned
# exFAT "linux" partition (nvme0n1p3, probe 5001) as wallace-root.img. Every
# other NVMe partition and namespace is read-only and no SD card is touched;
# the only writes are the new file on p3. Every gate is passed before the
# first write. (SD64, the original clone source, is unavailable.)
#
#   copy:   xzcat image -> p3/wallace-root.img.partial (hashed in-stream),
#           compare with the pinned raw hash, drop caches, re-hash from the SSD
#   check:  e2fsck -fn on a loop, UUID via findfs, size
#   commit: rename to wallace-root.img, umount, fsck.exfat -n, clean reboot
BB=/bin/busybox
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
early_stop() { echo "NVME-INSTALL STOP: $*"; while :; do $BB sleep 60; done; }
$BB mount -t proc proc /proc || early_stop proc
$BB mount -t sysfs sysfs /sys || early_stop sysfs
$BB mount -t devtmpfs devtmpfs /dev || early_stop devtmpfs
$BB mkdir -p /run /mnt/linux || early_stop directories
$BB mount -t tmpfs tmpfs /run || early_stop tmpfs
# Keyboard must be configured before either console can get a shell.
if ! $BB loadkmap </etc/wallace-no.bmap >/dev/tty0; then
    echo 'NVME-INSTALL STOP: Norwegian keymap failed' >/dev/kmsg
    while :; do $BB sleep 60; done
fi
say() { echo "NVME-INSTALL $*" >/dev/kmsg; }
LOOP=
park() {
    [ -z "$LOOP" ] || $BB losetup -d "$LOOP" 2>/dev/null
    $BB umount /mnt/linux 2>/dev/null
    say 'PARKED: no further automated storage operations'
    $BB setsid -c $BB sh -i </dev/ttydc0 >/dev/ttydc0 2>&1 &
    while :; do $BB setsid -c $BB sh -i </dev/tty1 >/dev/tty1 2>&1; $BB sleep 1; done
}
stop() { say "STOP: $*"; park; }
if [ -c /dev/watchdog0 ]; then
    $BB watchdog -T 30 -t 10 /dev/watchdog0 &
else
    stop 'watchdog missing'
fi
set -o pipefail
ROOT_UUID=988d97b4-06ba-40d7-8f70-7899bb6fa297
ROOT_BYTES=17179869184
SRC=/wallace-root.img.xz
EXP=$($BB cut -d' ' -f1 /wallace-root.img.sha256 2>/dev/null)
[ -f $SRC ] && [ ${#EXP} = 64 ] || stop 'embedded root image or its hash is missing'
say "start; maxcpus=1; embedded root image $ROOT_UUID raw sha256=$EXP"

# --- NVMe controller, namespace and identity gate (as 5003) -----------------
ns_size() { $BB cat "/sys/block/$1/size" 2>/dev/null; }
i=0
while [ ! -b /dev/nvme0n1p3 ] && [ "$i" -lt 30 ]; do $BB sleep 1; i=$((i+1)); done
[ ! -e /dev/nvme1 ] || stop 'unexpected second controller'
i=0
while { [ ! -b /dev/nvme0n2 ] || [ ! -b /dev/nvme0n3 ]; } && [ "$i" -lt 10 ]; do $BB sleep 1; i=$((i+1)); done
[ "$(ns_size nvme0n1)" = 1954210120 ] && [ "$(ns_size nvme0n2)" = 6144 ] &&
    [ "$(ns_size nvme0n3)" = 262144 ] && [ ! -e /dev/nvme0n4 ] ||
    stop 'unexpected namespace topology'
case "$($BB cat /sys/class/nvme/nvme0/transport):$($BB cat /sys/class/nvme/nvme0/model)" in
    apple-nvme:APPLE\ SSD\ AP1024Z*) ;;
    *) stop 'unexpected controller identity' ;;
esac
P=nvme0n1p3
DEV=/dev/$P
for d in /dev/nvme0n1p1 /dev/nvme0n1p2 /dev/nvme0n1p4 /dev/nvme0n2 /dev/nvme0n3; do
    [ -b "$d" ] || stop "missing $d"
    $BB blockdev --setro "$d" || stop "cannot set $d read-only"
done
[ ! -e /dev/nvme0n1p5 ] || stop 'unexpected fifth partition'
[ "$($BB cat /sys/block/nvme0n1/$P/ro)" = 0 ] || stop "$P is read-only"
others() {
    for n in nvme0n1/nvme0n1p1 nvme0n1/nvme0n1p2 nvme0n1/nvme0n1p4 nvme0n2 nvme0n3; do
        # Writes, discards and flushes only (fields 5-7, 12-17): findfs reads
        # every superblock, which is not I/O that matters here (5008 B1).
        set -- $($BB cat "/sys/block/$n/stat"); echo "$5 $6 $7 ${12} ${13} ${14} ${16} ${17}"
    done | $BB sha256sum
}
OTHERS_BEFORE=$(others)
hex() { $BB dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | $BB hexdump -v -e '1/1 "%02x"'; }
[ "$($BB cat /sys/block/nvme0n1/$P/start)" = 1586917376 ] || stop 'p3 start mismatch'
[ "$($BB cat /sys/block/nvme0n1/$P/size)" = 356806656 ] || stop 'p3 size mismatch'
[ "$($BB cat /sys/block/nvme0n1/queue/logical_block_size)" = 4096 ] || stop 'unexpected logical block size'
E=8448   # GPT entry array at LBA 2 (4 KiB); p3 is slot 2
[ "$(hex /dev/nvme0n1 $E 16)" = a2a0d0ebe5b9334487c068b6b72699c7 ] || stop 'p3 GPT type is not Microsoft Basic Data'
[ "$(hex /dev/nvme0n1 $((E + 16)) 16)" = dba60dea3529cb49a996b982dd646f24 ] || stop 'p3 GPT unique GUID mismatch'
[ "$(hex /dev/nvme0n1 $((E + 32)) 16)" = 00ced20b00000000ff5b7b0e00000000 ] || stop 'p3 GPT LBA range mismatch'
[ "$($BB dd if=$DEV bs=1 skip=3 count=8 2>/dev/null)" = "EXFAT   " ] || stop 'p3 is not exFAT'
[ "$(hex $DEV 100 4)" = af2cdd6a ] || stop 'exFAT serial is not 0x6add2caf'
[ "$(hex $DEV 7733248 12)" = 83056c0069006e0075007800 ] || stop 'exFAT label is not "linux"'
# exFAT VolumeFlags (LE word at 106), bit 1 = dirty: never mount a dirty p3 rw.
vflags() { F=$($BB dd if=$DEV bs=1 skip=106 count=2 2>/dev/null | $BB od -An -tu2); F=${F##* }; }
vflags
[ -n "$F" ] || stop 'cannot read p3 VolumeFlags'
if [ $((F & 2)) -ne 0 ]; then
    # A hard reset after an unflushed unmount leaves the bit set (211 r2).
    # Repair p3 only, as the sdroot init does for SD64, then re-check.
    echo "write through" >/sys/block/nvme0n1/queue/write_cache 2>/dev/null
    out=$(/sbin/fsck.exfat -y $DEV 2>&1); rc=$?
    say "p3 dirty (VolumeFlags=$F): fsck.exfat -y rc=$rc: $(echo "$out" | $BB tail -1 | $BB cut -c1-160)"
    vflags
    [ $((F & 2)) -eq 0 ] || stop "p3 exFAT still dirty (VolumeFlags=$F) after repair"
fi
say "p3 pins OK: start=1586917376 size=356806656 type=EBD0A0A2 guid=EA0DA6DB serial=6add2caf label=linux clean"

# --- copy ----------------------------------------------------------------------
fsck_n() {
    out=$(/sbin/fsck.exfat -n $DEV 2>&1); rc=$?
    say "fsck.exfat -n ($1) rc=$rc: $(echo "$out" | $BB tail -1 | $BB cut -c1-200)"
    [ "$rc" -eq 0 ] || stop "p3 exFAT not clean ($1)"
}
wsec() { set -- $($BB cat "$1"); echo "$7"; }   # field 7 = sectors written
# ANS2 rejects NVMe Flush (5006): write-through before the first mount.
echo "write through" >/sys/block/nvme0n1/queue/write_cache 2>/dev/null
[ "$($BB cat /sys/block/nvme0n1/queue/write_cache)" = "write through" ] || stop 'cannot set write-through'
say "write_cache=write through"
fsck_n before
DISK_W0=$(wsec /sys/block/nvme0n1/stat); P_W0=$(wsec /sys/block/nvme0n1/$P/stat)
up() { $BB cut -d' ' -f1 /proc/uptime; }
$BB mount -t exfat -o rw $DEV /mnt/linux || stop 'p3 mount rw failed'
DST=/mnt/linux/wallace-root.img
[ ! -e $DST ] || stop "$DST already exists; nothing to install"
$BB rm -f $DST.partial
t0=$(up)
H=$($BB xzcat $SRC | $BB tee $DST.partial | $BB sha256sum) || stop 'copy failed'
H=${H%% *}
$BB sync
t1=$(up)
[ "$($BB stat -c %s $DST.partial)" = $ROOT_BYTES ] || stop 'copy has the wrong size'
say "wrote $ROOT_BYTES bytes in $t0..$t1 s; sha256=$H expected=$EXP"
[ "$H" = "$EXP" ] || stop 'decompressed image differs from the pinned hash'
echo 3 >/proc/sys/vm/drop_caches || stop 'drop_caches failed'
G=$($BB sha256sum $DST.partial); G=${G%% *}
say "re-read copy sha256=$G"
[ "$G" = "$EXP" ] || stop 'copy on p3 differs from the pinned hash'

# --- check ---------------------------------------------------------------------
LOOP=$($BB losetup -f) && $BB losetup -r "$LOOP" $DST.partial || stop 'cannot attach the copy'
e2() { out=$("$@" 2>&1); rc=$?; say "$* rc=$rc: $(echo "$out" | $BB tail -1 | $BB cut -c1-200)"; return $rc; }
e2 e2fsck -fn "$LOOP" || stop 'root image has ext4 errors'
[ "$($BB findfs UUID=$ROOT_UUID 2>/dev/null)" = "$LOOP" ] || stop 'root UUID not visible'
B=$($BB blockdev --getsize64 "$LOOP")
[ "$B" = $ROOT_BYTES ] || stop "loop size $B"
$BB losetup -d "$LOOP" || stop 'cannot detach the copy'
LOOP=

# --- commit ---------------------------------------------------------------------
$BB mv $DST.partial $DST || stop 'rename failed'
$BB sync
$BB umount /mnt/linux || stop 'p3 would not unmount'
fsck_n final
[ "$(others)" = "$OTHERS_BEFORE" ] || stop 'a read-only partition or namespace saw I/O'
DISK_DW=$(( $(wsec /sys/block/nvme0n1/stat) - DISK_W0 ))
P_DW=$(( $(wsec /sys/block/nvme0n1/$P/stat) - P_W0 ))
say "sectors written: disk=$DISK_DW p3=$P_DW"
[ "$DISK_DW" = "$P_DW" ] || stop 'writes outside p3 on nvme0n1'
say "PASS installed wallace-root.img bytes=$ROOT_BYTES uuid=$ROOT_UUID sha256=$H others_unchanged=yes"
# Without Flush the newest writes sit in the controller's volatile cache until
# a controller shutdown (211 r3): reboot through device_shutdown before anyone
# can hard-reset the machine.
say "clean kernel reboot: device_shutdown -> apple_nvme_shutdown (CC.SHN)"
$BB sync
$BB reboot -f
$BB sleep 30
say 'reboot -f returned'
park
