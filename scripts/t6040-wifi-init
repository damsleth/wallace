#!/bin/sh
# /init for the WiFi/BT test root (ticket 168).
#
# Deliberately does NOT use openrc. When this Alpine tree is used as an
# initramfs root via rdinit, openrc's sysinit does not populate /dev, so the
# inittab gettys fail with "can't open /dev/tty0: no such file or directory"
# and the ttydc0 helper reports "ttydc0 absent after 30s" -- observed on the
# panel, 2026-07-29. Mount the three pseudo-filesystems ourselves, then put a
# shell on the DockChannel UART exactly the way the proven minimal dcuart root
# does, so the whole WiFi sequence can be driven from the host over KIS.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH HOME=/root TERM=vt100

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mount -t tmpfs none /tmp 2>/dev/null
mkdir -p /run /var/run 2>/dev/null
mount -t tmpfs none /run 2>/dev/null

echo ""
echo "=== t6040 WiFi/BT test root ==="
uname -a

# Keep the watchdog fed so a wedged shell does not strand the machine.
[ -c /dev/watchdog0 ] && { watchdog -T 30 -t 10 /dev/watchdog0 & }

# The DockChannel tty registers asynchronously.
n=0
while [ ! -c /dev/ttydc0 ] && [ "$n" -lt 20 ]; do sleep 1; n=$((n + 1)); done

if [ ! -c /dev/ttydc0 ]; then
    echo "FATAL: /dev/ttydc0 absent after ${n}s; /dev contents:" >/dev/console
    ls /dev >/dev/console 2>&1
    exec sh
fi


# Hold the port open for the life of init: the driver has shown close/reopen
# fragility, and a final close kills output dead.
exec 9<>/dev/ttydc0

# --- SMP evidence straight to the console --------------------------------
# Print this before anything else can fail: the panel is the one channel that
# always works for this kernel/DTB, so the CPU answer must not depend on sshd or
# on the network coming up. Marker strings are greppable in a photo.
{
    echo ""
    echo "T6040_SMP_REPORT_BEGIN"
    echo "cmdline: $(cat /proc/cmdline)"
    for f in possible present online; do
        echo "cpu_$f: $(cat /sys/devices/system/cpu/$f 2>/dev/null)"
    done
    echo "processor_count: $(grep -c '^processor' /proc/cpuinfo)"
    grep -E '^processor|^CPU part' /proc/cpuinfo | tr '\n' ' '; echo ""
    echo "T6040_SMP_REPORT_END"
    echo ""
} > /dev/console 2>&1

# --- bring up networking and sshd in the background -----------------------
# Point of this image: iterate userspace over the network instead of one command
# at a time through the DebugUSB pty. Everything here is best-effort -- a failure
# must still leave the ttydc0 shell usable, because that is the fallback.
(
    ip link set lo up 2>/dev/null
    if grep -q '^[[:space:]]*ssid=' /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null; then
        ip link set wlan0 up 2>/dev/null
        wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf 2>&1
        # Give association a moment before asking for a lease.
        n=0
        while [ "$n" -lt 15 ]; do
            iw dev wlan0 link 2>/dev/null | grep -q '^Connected' && break
            sleep 1; n=$((n + 1))
        done
        udhcpc -i wlan0 -t 6 -T 2 -b 2>&1
    fi
    # Host keys are generated here, not shipped: no private key in a build
    # artifact. ssh-keygen -A is a no-op once they exist.
    ssh-keygen -A >/dev/null 2>&1
    mkdir -p /var/empty /run
    if [ -s /root/.ssh/authorized_keys ]; then
        /usr/sbin/sshd -e 2>&1
        addr=$(ip -4 -br addr show wlan0 2>/dev/null)
        echo "sshd up; wlan0: ${addr:-no address}" >&9 2>/dev/null
    else
        echo "sshd NOT started: /root/.ssh/authorized_keys is missing/empty" >&9 2>/dev/null
    fi
) &

{
    echo ""
    echo "*** t6040 WiFi/BT test root — shell on ttydc0 ***"
    echo "run: t6040-wifi-report     (pci, iw scan, mac, bluetooth)"
    echo "ssh: root@<wlan0 addr>, key-only (host keys generated at boot)"
    echo "then: wpa_passphrase SSID PSK > /tmp/wpa.conf"
    echo "      wpa_supplicant -B -i wlan0 -c /tmp/wpa.conf && udhcpc -i wlan0"
    echo ""
} >&9

while :; do
    setsid sh -c 'exec sh -i <>/dev/ttydc0 >&0 2>&1' || sleep 2
    sleep 1
done
