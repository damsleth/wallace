#!/sbin/openrc-run

description="Ping the T6040 hardware watchdog"
pidfile="/run/t6040-watchdog.pid"

start()
{
    if [ ! -c /dev/watchdog0 ]; then
        eerror "/dev/watchdog0 is absent"
        return 1
    fi
    ebegin "Starting T6040 watchdog"
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$pidfile" --exec /sbin/watchdog -- \
        -T 30 -t 10 /dev/watchdog0
    eend $?
}

stop()
{
    ebegin "Stopping T6040 watchdog"
    start-stop-daemon --stop --pidfile "$pidfile" --retry TERM/5/KILL/2
    rc=$?
    rm -f "$pidfile"
    eend "$rc"
}
