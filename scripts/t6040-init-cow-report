#!/bin/busybox sh
# Storage-free fault-205 characterisation init (ticket 217, consumed by 209).
# Records the logical-CPU -> MIDR/cluster/core map, then runs the unmodified
# t6040-cow-repro.sh four times in this one boot. Every line goes to /dev/kmsg
# so it reaches the serial console next to the kernel's own oops output, which
# already names the faulting logical CPU ("CPU: N UID: ..."). Mounts nothing
# but proc, sysfs and devtmpfs; touches no block device.
BB=/bin/busybox
$BB mount -t proc none /proc
$BB mount -t sysfs none /sys
$BB mount -t devtmpfs none /dev 2>/dev/null

# Norwegian console keymap before any shell (AGENTS.md: no exceptions).
$BB loadkmap </etc/wallace-no.bmap 2>/dev/null || echo "cow-report: WARNING loadkmap failed" >/dev/kmsg

say() { echo "cow-report: $*" >/dev/kmsg; }

say "T6040_COW_REPORT_BEGIN"
say "cmdline: $($BB cat /proc/cmdline)"
for f in possible present online; do
    say "cpu_$f: $($BB cat /sys/devices/system/cpu/$f 2>/dev/null)"
done
for c in /sys/devices/system/cpu/cpu[0-9]*; do
    [ -r "$c/online" ] && [ "$($BB cat "$c/online")" = 0 ] && continue
    n=${c##*cpu}
    say "cpu$n midr=$($BB cat "$c/regs/identification/midr_el1" 2>/dev/null) cluster=$($BB cat "$c/topology/cluster_id" 2>/dev/null) core=$($BB cat "$c/topology/core_id" 2>/dev/null) package=$($BB cat "$c/topology/physical_package_id" 2>/dev/null)"
done
# The kernel's own logical-CPU -> MPIDR/MIDR lines from SMP bring-up.
$BB dmesg | $BB grep -E 'Booted secondary processor|Booting Linux on physical CPU' |
    while read -r l; do say "boot: $l"; done

for run in 1 2 3 4; do
    say "T6040_COW_RUN_BEGIN run=$run"
    $BB sh /usr/local/bin/t6040-cow-repro.sh 2>&1 | while read -r l; do say "run=$run $l"; done
    say "T6040_COW_RUN_END run=$run"
done
say "T6040_COW_REPORT_END"

while :; do $BB sleep 3600; done
