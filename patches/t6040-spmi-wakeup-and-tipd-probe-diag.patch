@@ -187,13 +188,25 @@ static int tps6598x_spmi_probe(struct spmi_device *sdev)
 	 * harmless if the part is already awake. Reaching S0 itself is left to
 	 * cd321x_data.switch_power_state inside tps6598x_probe_common().
 	 */
-	spmi_command_wakeup(sdev);
+	ret = spmi_command_wakeup(sdev);
+	if (ret)
+		return dev_err_probe(&sdev->dev, ret, "SPMI WAKEUP failed\n");
+	/*
+	 * Proven on J614s hpm2 (tickets 093/094): the select/data window reads
+	 * back zero until about 10 ms after WAKEUP.
+	 */
+	usleep_range(10000, 11000);
 
 	regmap = devm_regmap_init(&sdev->dev, &tps6598x_spmi_regmap_bus, sdev,
 				  &tps6598x_regmap_config);
 	if (IS_ERR(regmap))
 		return PTR_ERR(regmap);
 
+	/* Logical system-power-state (0x20), as read in ticket 094. */
+	ret = regmap_raw_read(regmap, 0x20, &power_state, 1);
+	dev_info(&sdev->dev, "after WAKEUP: power-state read ret=%d state=0x%02x\n",
+		 ret, power_state);
+
 	irq = of_irq_get(sdev->dev.of_node, 0);
 	if (irq == -EPROBE_DEFER)
 		return irq;
