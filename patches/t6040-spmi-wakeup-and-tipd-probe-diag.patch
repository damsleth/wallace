diff --git a/drivers/spmi/spmi-apple-controller.c b/drivers/spmi/spmi-apple-controller.c
index 87e3ee9..e00967c 100644
--- a/drivers/spmi/spmi-apple-controller.c
+++ b/drivers/spmi/spmi-apple-controller.c
@@ -119,6 +119,40 @@ static int spmi_write_cmd(struct spmi_controller *ctrl, u8 opc, u8 sid,
 	return 0;
 }
 
+/* SPMI WAKEUP; the only bare command this controller is allowed to send. */
+#define APPLE_SPMI_OPC_WAKEUP 0x13
+
+static int apple_spmi_cmd(struct spmi_controller *ctrl, u8 opc, u8 sid)
+{
+	struct apple_spmi *spmi = spmi_controller_get_drvdata(ctrl);
+	u32 rsp;
+	int ret;
+
+	/*
+	 * WAKEUP only. This driver also serves the system PMU bus, which must
+	 * never be sent RESET, SLEEP or SHUTDOWN.
+	 */
+	if (opc != APPLE_SPMI_OPC_WAKEUP)
+		return -EOPNOTSUPP;
+
+	/* Bare command: no payload, so no length field and no data words. */
+	writel(opc | sid << 8 | BIT(15), spmi->regs + SPMI_CMD_REG);
+
+	ret = apple_spmi_wait_rx_not_empty(ctrl);
+	if (ret)
+		return ret;
+
+	/* The reply echoes opcode (7:0) and SID (14:8) and sets ACK (15). */
+	rsp = readl(spmi->regs + SPMI_RSP_REG);
+	if ((rsp & 0xff) != opc || ((rsp >> 8) & 0x7f) != sid || !(rsp & BIT(15))) {
+		dev_err(&ctrl->dev, "WAKEUP to SID %u: unexpected reply 0x%08x\n",
+			sid, rsp);
+		return -EIO;
+	}
+
+	return 0;
+}
+
 static int apple_spmi_probe(struct platform_device *pdev)
 {
 	struct apple_spmi *spmi;
@@ -137,6 +171,7 @@ static int apple_spmi_probe(struct platform_device *pdev)
 
 	ctrl->dev.of_node = pdev->dev.of_node;
 
+	ctrl->cmd = apple_spmi_cmd;
 	ctrl->read_cmd = spmi_read_cmd;
 	ctrl->write_cmd = spmi_write_cmd;
 
