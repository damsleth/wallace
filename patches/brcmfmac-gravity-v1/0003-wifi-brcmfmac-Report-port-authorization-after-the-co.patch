From 426ef46e3ac6d43ef5ae2aaa1e613572249cdeda Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 9 Oct 2026 04:00:49 -0400
Subject: [PATCH] wifi: brcmfmac: Report port authorization after the connect
 result

Offload authentication (FWSUP_PSK/SAE) reported port authorization
before cfg80211_connect_done(). cfg80211 handles both queued events in
order, so the port authorized event ran while the wdev was not yet
connected, hitting WARN_ON(!wdev->connected) in
__cfg80211_port_authorized() on every join. Report it after the
connect result instead.

Fixes: 3afb9971c1275 ("wifi: brcmfmac: cfg80211: Report port_authorized for offload auth")
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Original-Commit: 3d487d3678098df2367836a8df8b6e69906789b7
Signed-off-by: Cody Ho <codyho@stanford.edu>
Assisted-By: LLM
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 03eb112f2ce2..e9a3c1db08f4 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -6464,6 +6464,7 @@ brcmf_bss_connect_done(struct brcmf_cfg80211_info *cfg,
 	struct brcmf_cfg80211_profile *profile = &ifp->vif->profile;
 	struct brcmf_cfg80211_connect_info *conn_info = cfg_to_conn(cfg);
 	struct cfg80211_connect_resp_params conn_params;
+	bool authorized = false;
 
 	brcmf_dbg(TRACE, "Enter\n");
 
@@ -6473,12 +6474,8 @@ brcmf_bss_connect_done(struct brcmf_cfg80211_info *cfg,
 		if (completed) {
 			brcmf_get_assoc_ies(cfg, ifp);
 			brcmf_update_bss_info(cfg, ifp);
-			if ((profile->use_fwsup == BRCMF_PROFILE_FWSUP_SAE) ||
-			    (profile->use_fwsup == BRCMF_PROFILE_FWSUP_PSK)) {
-				cfg80211_port_authorized(ndev, profile->bssid,
-							 NULL, 0, GFP_KERNEL);
-				brcmf_dbg(CONN, "Report port authorized\n");
-			}
+			authorized = profile->use_fwsup == BRCMF_PROFILE_FWSUP_SAE ||
+				     profile->use_fwsup == BRCMF_PROFILE_FWSUP_PSK;
 			set_bit(BRCMF_VIF_STATUS_CONNECTED,
 				&ifp->vif->sme_state);
 			conn_params.status = WLAN_STATUS_SUCCESS;
@@ -6497,6 +6494,16 @@ brcmf_bss_connect_done(struct brcmf_cfg80211_info *cfg,
 		cfg80211_connect_done(ndev, &conn_params, GFP_KERNEL);
 		brcmf_dbg(CONN, "Report connect result - connection %s\n",
 			  completed ? "succeeded" : "failed");
+		/*
+		 * cfg80211 handles queued events in order and only accepts
+		 * port authorization once the connection is established, so
+		 * report it after the connect result.
+		 */
+		if (authorized) {
+			cfg80211_port_authorized(ndev, profile->bssid, NULL, 0,
+						 GFP_KERNEL);
+			brcmf_dbg(CONN, "Report port authorized\n");
+		}
 	}
 	brcmf_dbg(TRACE, "Exit\n");
 	return 0;
-- 
