+/* Stage-1 translation of a write at VA in the current (EL2&0, VHE) regime. */
+static u64 t6040_205_at_s1e2w(unsigned long va)
+{
+	if (!is_kernel_in_hyp_mode())
+		return ~0ULL;	/* S1E2W UNDEFs at EL1 */
+	asm volatile("at s1e2w, %0" : : "r" (va));
+	isb();
+	return read_sysreg_par();
+}
+
+/*
+ * Early probe (Mythos 5012 review): before the initramfs unpack, own the
+ * physical page right after m1n1's ADT phram reservation, which held every
+ * captured 205 fault, plus an unrelated control page, and check from every
+ * online CPU a nofault read, a write-back of the same value, and AT S1E2W.
+ */
+struct t6040_205_probe {
+	unsigned long *va;
+	u64 rd_fail, wr_fail;
+	u64 par[NR_CPUS];
+};
+
+static void t6040_205_probe_cpu(void *arg)
+{
+	struct t6040_205_probe *pr = arg;
+	int cpu = smp_processor_id();
+	unsigned long v = 0;
+
+	pr->par[cpu] = t6040_205_at_s1e2w((unsigned long)pr->va);
+	if (copy_from_kernel_nofault(&v, pr->va, sizeof(v)))
+		pr->rd_fail |= BIT_ULL(cpu);
+	else if (copy_to_kernel_nofault(pr->va, &v, sizeof(v)))
+		pr->wr_fail |= BIT_ULL(cpu);
+}
+
+static void __init t6040_205_probe_page(const char *what, struct page *pg)
+{
+	static struct t6040_205_probe pr;
+	int cpu;
+
+	memset(&pr, 0, sizeof(pr));
+	pr.va = page_address(pg);
+	for_each_online_cpu(cpu)
+		smp_call_function_single(cpu, t6040_205_probe_cpu, &pr, 1);
+	pr_emerg("t6040-205: probe %s PA %016llx VA %px: read_fail_cpus=%llx write_fail_cpus=%llx\n",
+		 what, (u64)page_to_phys(pg), pr.va, pr.rd_fail, pr.wr_fail);
+	for_each_online_cpu(cpu)
+		pr_emerg("t6040-205: probe %s cpu%d PAR_EL1 %016llx\n", what, cpu, pr.par[cpu]);
+}
+
+/* PAR only: no ownership, no memory access. */
+static void t6040_205_par_cpu(void *arg)
+{
+	struct t6040_205_probe *pr = arg;
+
+	pr->par[smp_processor_id()] = t6040_205_at_s1e2w((unsigned long)pr->va);
+}
+
+static void __init t6040_205_par_window(phys_addr_t pa, const char *what)
+{
+	static struct t6040_205_probe pr;
+	int cpu;
+
+	memset(&pr, 0, sizeof(pr));
+	pr.va = __va(pa);
+	for_each_online_cpu(cpu)
+		smp_call_function_single(cpu, t6040_205_par_cpu, &pr, 1);
+	for_each_online_cpu(cpu)
+		pr_emerg("t6040-205: par %s PA %016llx cpu%d PAR_EL1 %016llx\n",
+			 what, (u64)pa, cpu, pr.par[cpu]);
+}
+
+/*
+ * Probe v2 (Mythos, after 5012 boots a/b): is the secondaries' walker reading
+ * different page-table memory than the boot CPU? Per CPU: translation
+ * registers and the walked descriptors for adt_end; an AT grid across the
+ * 32 MiB L3-table boundaries; then broadcast TLBI + AT (control), and the
+ * executing CPU's clean+invalidate of the descriptor lines + broadcast TLBI
+ * + AT. Reviewed by Codex (no Device alias, validated walk, pinned civac).
+ */
+struct t6040_205_regs {
+	u64 ttbr0, ttbr1, tcr, sctlr, mair, hcr, vtcr, mmfr3, tcr2, pir, pire0;
+};
+static struct t6040_205_regs t6040_205_r[NR_CPUS];
+static u64 *t6040_205_desc[3];	/* L1 (pgd), L2 (pmd), L3 (pte) entries */
+static u64 t6040_205_dval[NR_CPUS][3];
+
+static void t6040_205_regs_cpu(void *arg)
+{
+	struct t6040_205_regs *r = &t6040_205_r[smp_processor_id()];
+	int i;
+
+	r->ttbr0 = read_sysreg(ttbr0_el1);	/* VHE: redirected to EL2 */
+	r->ttbr1 = read_sysreg(ttbr1_el1);
+	r->tcr = read_sysreg(tcr_el1);
+	r->sctlr = read_sysreg(sctlr_el1);
+	r->mair = read_sysreg(mair_el1);
+	r->hcr = read_sysreg(hcr_el2);
+	r->vtcr = read_sysreg(vtcr_el2);
+	r->mmfr3 = read_sysreg_s(SYS_ID_AA64MMFR3_EL1);
+	if ((r->mmfr3 >> ID_AA64MMFR3_EL1_TCRX_SHIFT) & 0xf)
+		r->tcr2 = read_sysreg_s(SYS_TCR2_EL1);
+	if ((r->mmfr3 >> ID_AA64MMFR3_EL1_S1PIE_SHIFT) & 0xf) {
+		r->pir = read_sysreg_s(SYS_PIR_EL1);
+		r->pire0 = read_sysreg_s(SYS_PIRE0_EL1);
+	}
+	for (i = 0; i < 3; i++)
+		t6040_205_dval[smp_processor_id()][i] =
+			t6040_205_desc[i] ? READ_ONCE(*t6040_205_desc[i]) : 0;
+}
+
+static void __init t6040_205_probe_v2(unsigned long pfn)
+{
+	static const char * const lvl[3] = { "L1(pgd)", "L2(pmd)", "L3(pte)" };
+	unsigned long va = (unsigned long)__va(PFN_PHYS(pfn));
+	phys_addr_t b0 = ALIGN_DOWN(PFN_PHYS(pfn), SZ_32M), b1 = b0 + SZ_32M;
+	const phys_addr_t grid[] = {
+		PFN_PHYS(pfn) - SZ_64M, b0 - SZ_32M, b0 - 2 * PAGE_SIZE, b0 - PAGE_SIZE,
+		b0, b0 + PAGE_SIZE, PFN_PHYS(pfn) - SZ_8M, PFN_PHYS(pfn) + SZ_8M,
+		b1 - 2 * PAGE_SIZE, b1 - PAGE_SIZE, b1, b1 + PAGE_SIZE,
+		b1 + SZ_32M, PFN_PHYS(pfn) + SZ_64M,
+	};
+	pgd_t *pgdp;
+	pud_t *pudp;
+	pmd_t *pmdp;
+	pte_t *ptep;
+	int cpu, i, ret, me;
+
+	/* Validated walk; with 16K/47-bit, p4d and pud fold into the pgd. */
+	pgdp = pgd_offset_k(va);
+	if (pgd_none(READ_ONCE(*pgdp)) || pgd_bad(READ_ONCE(*pgdp)))
+		goto bad;
+	pudp = pud_offset(p4d_offset(pgdp, va), va);
+	if (pud_none(READ_ONCE(*pudp)) || pud_leaf(READ_ONCE(*pudp)) || pud_bad(READ_ONCE(*pudp)))
+		goto bad;
+	pmdp = pmd_offset(pudp, va);
+	if (pmd_none(READ_ONCE(*pmdp)) || pmd_leaf(READ_ONCE(*pmdp)) || pmd_bad(READ_ONCE(*pmdp)))
+		goto bad;
+	ptep = pte_offset_kernel(pmdp, va);
+	if (!pte_valid(__ptep_get(ptep)))
+		goto bad;
+	t6040_205_desc[0] = (u64 *)pgdp;
+	t6040_205_desc[1] = (u64 *)pmdp;
+	t6040_205_desc[2] = (u64 *)ptep;
+
+	/* 3. Translation registers and descriptor loads, per CPU. */
+	for_each_online_cpu(cpu) {
+		ret = smp_call_function_single(cpu, t6040_205_regs_cpu, NULL, 1);
+		if (ret)
+			pr_emerg("t6040-205: v2 regs cpu%d IPI failed %d\n", cpu, ret);
+	}
+	pr_emerg("t6040-205: v2 software root init_mm.pgd PA %016llx\n",
+		 (u64)virt_to_phys(init_mm.pgd));
+	for_each_online_cpu(cpu) {
+		struct t6040_205_regs *r = &t6040_205_r[cpu];
+
+		pr_emerg("t6040-205: v2 regs cpu%d ttbr0 %llx ttbr1 %llx tcr %llx sctlr %llx mair %llx hcr %llx vtcr %llx mmfr3 %llx tcr2 %llx pir %llx pire0 %llx\n",
+			 cpu, r->ttbr0, r->ttbr1, r->tcr, r->sctlr, r->mair, r->hcr,
+			 r->vtcr, r->mmfr3, r->tcr2, r->pir, r->pire0);
+		for (i = 0; i < 3; i++)
+			pr_emerg("t6040-205: v2 desc cpu%d %s @PA %016llx = %016llx\n",
+				 cpu, lvl[i], (u64)__pa(t6040_205_desc[i]),
+				 t6040_205_dval[cpu][i]);
+	}
+	/* 2. AT grid across the L3-table (32 MiB) boundaries. */
+	for (i = 0; i < ARRAY_SIZE(grid); i++) {
+		if (!pfn_valid(PHYS_PFN(grid[i])) || !memblock_is_map_memory(grid[i]))
+			continue;
+		t6040_205_par_window(grid[i], "grid");
+	}
+	/*
+	 * 1. Coherency. Control: broadcast TLBI, then AT everywhere. Test: the
+	 * executing CPU cleans+invalidates the descriptor lines to PoC, dsb sy,
+	 * broadcast TLBI, AT everywhere. 5012 a/b showed TLBI alone never helps.
+	 */
+	flush_tlb_all();
+	t6040_205_par_window(PFN_PHYS(pfn), "control-tlbi adt_end+0");
+	me = get_cpu();
+	for (i = 0; i < 3; i++)
+		dcache_clean_inval_poc((unsigned long)t6040_205_desc[i],
+				       (unsigned long)t6040_205_desc[i] + sizeof(u64));
+	dsb(sy);
+	flush_tlb_all();
+	put_cpu();
+	pr_emerg("t6040-205: v2 civac of the 3 descriptor lines done on cpu%d\n", me);
+	t6040_205_par_window(PFN_PHYS(pfn), "post-civac-tlbi adt_end+0");
+	return;
+bad:
+	pr_emerg("t6040-205: v2 walk for VA %016lx not a valid L3 mapping; v2 skipped\n", va);
+}
+
+static int __init t6040_205_probe(void)
+{
+	struct device_node *np;
+	struct resource res;
+	unsigned long pfn = 0;
+	struct page *ctl;
+
+	for_each_compatible_node(np, NULL, "phram") {
+		const char *label;
+
+		if (!of_property_read_string(np, "label", &label) && !strcmp(label, "adt") &&
+		    !of_address_to_resource(np, 0, &res)) {
+			pfn = PHYS_PFN(res.end + 1);
+			of_node_put(np);
+			break;
+		}
+	}
+	if (pfn) {
+		static const struct { const char *what; long off; } win[] = {
+			{ "adt_last", -1 }, { "adt_end+0", 0 }, { "adt_end+1", 1 },
+			{ "adt_end+2", 2 }, { "adt_end+3", 3 }, { "adt_end+16", 16 },
+		};
+		int i;
+
+		for (i = 0; i < ARRAY_SIZE(win); i++)
+			t6040_205_par_window(PFN_PHYS(pfn + win[i].off), win[i].what);
+		t6040_205_probe_v2(pfn);
+	}
+	if (!pfn) {
+		pr_emerg("t6040-205: probe: no phram node labelled adt\n");
+	} else if (alloc_contig_range(pfn, pfn + 1, ACR_FLAGS_NONE, GFP_KERNEL)) {
+		pr_emerg("t6040-205: probe: page after ADT (PA %016llx, ADT %pR) not allocatable; skipped\n",
+			 (u64)PFN_PHYS(pfn), &res);
+	} else {
+		pr_emerg("t6040-205: probe: ADT %pR, page after it PA %016llx owned\n",
+			 &res, (u64)PFN_PHYS(pfn));
+		t6040_205_probe_page("adt_end", pfn_to_page(pfn));
+		free_contig_range(pfn, 1);
+	}
+	ctl = alloc_page(GFP_KERNEL);
+	if (ctl) {
+		t6040_205_probe_page("control", ctl);
+		__free_page(ctl);
+	}
+	return 0;
+}
+postcore_initcall(t6040_205_probe);
+
+/*
+ * Wallace ticket 205 diagnostic, never a fix. 205's faults are EL1 write
+ * permission faults on linear-map pages whose in-memory leaf PTE permits
+ * writes. On such a fault the faulting instruction is retried in stages,
+ * keyed on (CPU, PC, VA) and bounded by a global budget:
+ *   stage 1  plain retry, no TLB maintenance (timing control)
+ *   stage 2  local TLBI (tlbi vmalle1; dsb nsh; isb), retry
+ *   stage 3  broadcast TLBI (flush_tlb_all), retry
+ *   stage 4  log AGAIN and fall through to the unchanged Oops
+ * Recovery is only inferred if the workload then progresses; absence of a
+ * further fault alone is "no recurrence observed". AGAIN does not exclude
+ * every translation-maintenance defect.
+ */
+#define T6040_205_BUDGET	32
+static DEFINE_RAW_SPINLOCK(t6040_205_lock);
+static struct {
+	int cpu, stage, budget_used;
+	unsigned long pc, va;
+} t6040_205_state = { .cpu = -1 };
+
+static bool t6040_205_stale_tlb_retry(unsigned long addr, unsigned long esr,
+				      struct pt_regs *regs)
+{
+	pgd_t *pgdp;
+	p4d_t *p4dp;
+	pud_t *pudp, pud;
+	pmd_t *pmdp, pmd;
+	pte_t pte;
+	unsigned long flags;
+	int cpu, stage;
+	bool retry = true;
+
+	if (ESR_ELx_EC(esr) != ESR_ELx_EC_DABT_CUR || !(esr & ESR_ELx_WNR) ||
+	    !esr_fsc_is_permission_fault(esr) || !virt_addr_valid((void *)addr))
+		return false;
+	pgdp = pgd_offset_k(addr);
+	if (pgd_none(READ_ONCE(*pgdp)) || pgd_bad(READ_ONCE(*pgdp)))
+		return false;
+	p4dp = p4d_offset(pgdp, addr);
+	if (p4d_none(READ_ONCE(*p4dp)) || p4d_bad(READ_ONCE(*p4dp)))
+		return false;
+	pudp = pud_offset(p4dp, addr);
+	pud = READ_ONCE(*pudp);
+	if (pud_none(pud) || pud_leaf(pud) || pud_bad(pud))
+		return false;
+	pmdp = pmd_offset(pudp, addr);
+	pmd = READ_ONCE(*pmdp);
+	if (pmd_none(pmd) || pmd_leaf(pmd) || pmd_bad(pmd))
+		return false;
+	pte = __ptep_get(pte_offset_kernel(pmdp, addr));
+	if (!pte_valid(pte) || (pte_val(pte) & PTE_RDONLY))
+		return false;	/* leaf AP forbids the write: not this bug */
+
+	raw_spin_lock_irqsave(&t6040_205_lock, flags);
+	cpu = smp_processor_id();
+	if (t6040_205_state.cpu == cpu && t6040_205_state.pc == regs->pc &&
+	    t6040_205_state.va == addr)
+		stage = t6040_205_state.stage + 1;
+	else
+		stage = 1;
+	if (stage <= 3 && t6040_205_state.budget_used >= T6040_205_BUDGET) {
+		stage = 0;	/* budget exhausted: no more retries anywhere */
+		retry = false;
+	} else if (stage <= 3) {
+		t6040_205_state.budget_used++;
+	}
+	t6040_205_state.cpu = stage > 3 || !retry ? -1 : cpu;
+	t6040_205_state.pc = regs->pc;
+	t6040_205_state.va = addr;
+	t6040_205_state.stage = stage;
+	if (stage == 2)
+		local_flush_tlb_all();
+	else if (stage == 3)
+		flush_tlb_all();
+	raw_spin_unlock_irqrestore(&t6040_205_lock, flags);
+
+	if (stage == 0) {
+		pr_emerg("t6040-205: retry budget exhausted; CPU%d VA %016lx handled as before\n",
+			 cpu, addr);
+		return false;
+	}
+	if (stage == 1)
+		pr_emerg("t6040-205: CPU%d PC %pS VA %016lx PA(lin) %016llx PA(pte) %016llx pte %016llx%s ESR %08lx PAR(at s1e2w) %016llx: stage 1 plain retry\n",
+			 cpu, (void *)regs->pc, addr, (u64)__pa(addr),
+			 (u64)__pte_to_phys(pte), pte_val(pte),
+			 (pte_val(pte) & PTE_CONT) ? " CONT" : "", esr,
+			 t6040_205_at_s1e2w(addr));
+	else if (stage == 2)
+		pr_emerg("t6040-205: CPU%d VA %016lx: faulted again after plain retry; stage 2 local TLBI + retry\n",
+			 cpu, addr);
+	else if (stage == 3)
+		pr_emerg("t6040-205: CPU%d VA %016lx: faulted again after local TLBI; stage 3 broadcast TLBI + retry\n",
+			 cpu, addr);
+	else {
+		unsigned long v;
+		int rd = copy_from_kernel_nofault(&v, (void *)addr, sizeof(v));
+
+		pr_emerg("t6040-205: CPU%d VA %016lx pte %016llx PAR(at s1e2w) %016llx read %s: faulted AGAIN after plain, local and broadcast retries\n",
+			 cpu, addr, pte_val(pte), t6040_205_at_s1e2w(addr),
+			 rd ? "FAULTS" : "ok");
+	}
+	return stage <= 3;
+}
