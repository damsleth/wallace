-	if (!client->irq)
+	if (!tps->irq)
 		cancel_delayed_work_sync(&tps->wq_poll);
 
 	return 0;
@@ -1931,8 +1957,7 @@ static int __maybe_unused tps6598x_suspend(struct device *dev)
 
 static int __maybe_unused tps6598x_resume(struct device *dev)
 {
-	struct i2c_client *client = to_i2c_client(dev);
-	struct tps6598x *tps = i2c_get_clientdata(client);
+	struct tps6598x *tps = dev_get_drvdata(dev);
 	int ret;
 
 	ret = tps6598x_check_mode(tps);
@@ -1946,25 +1971,25 @@ static int __maybe_unused tps6598x_resume(struct device *dev)
 	}
 
 	if (tps->wakeup) {
-		disable_irq_wake(client->irq);
-		enable_irq(client->irq);
+		disable_irq_wake(tps->irq);
+		enable_irq(tps->irq);
 	} else if (tps->reset) {
 		gpiod_set_value_cansleep(tps->reset, 0);
 		msleep(TPS_SETUP_MS);
 	}
 
-	if (!client->irq)
+	if (!tps->irq)
 		queue_delayed_work(system_power_efficient_wq, &tps->wq_poll,
 				   msecs_to_jiffies(POLL_INTERVAL));
 
 	return 0;
 }
 
-static const struct dev_pm_ops tps6598x_pm_ops = {
+const struct dev_pm_ops tps6598x_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(tps6598x_suspend, tps6598x_resume)
 };
 
-static const struct tipd_data cd321x_data = {
+const struct tipd_data cd321x_data = {
 	.irq_handler = cd321x_interrupt,
 	.irq_mask1 = APPLE_CD_REG_INT_POWER_STATUS_UPDATE |
 		     APPLE_CD_REG_INT_DATA_STATUS_UPDATE |
@@ -2039,11 +2064,42 @@ static struct i2c_driver tps6598x_i2c_driver = {
 		.pm = &tps6598x_pm_ops,
 		.of_match_table = tps6598x_of_match,
 	},
-	.probe = tps6598x_probe,
-	.remove = tps6598x_remove,
+	.probe = tps6598x_i2c_probe,
+	.remove = tps6598x_i2c_remove,
 	.id_table = tps6598x_id,
 };
-module_i2c_driver(tps6598x_i2c_driver);
+
+/*
+ * The SPMI transport (tps6598x_spmi.o) is part of this module. Register both
+ * bus drivers from one init so a single tps6598x.ko serves the I2C parts
+ * (M1/M2 apple,cd321x) and the SPMI parts (M4/T6040 usbc,sn201202x,spmi).
+ * tps6598x_spmi_{register,unregister}() are no-ops when the SPMI transport is
+ * not built (see tps6598x.h).
+ */
+static int __init tps6598x_module_init(void)
+{
+	int ret;
+
+	ret = i2c_add_driver(&tps6598x_i2c_driver);
+	if (ret)
+		return ret;
+
+	ret = tps6598x_spmi_register();
+	if (ret) {
+		i2c_del_driver(&tps6598x_i2c_driver);
+		return ret;
+	}
+
+	return 0;
+}
+module_init(tps6598x_module_init);
+
+static void __exit tps6598x_module_exit(void)
+{
+	tps6598x_spmi_unregister();
+	i2c_del_driver(&tps6598x_i2c_driver);
+}
+module_exit(tps6598x_module_exit);
 
 MODULE_AUTHOR("Heikki Krogerus <heikki.krogerus@linux.intel.com>");
 MODULE_LICENSE("GPL v2");
diff --git a/drivers/usb/typec/tipd/spmi.c b/drivers/usb/typec/tipd/spmi.c
new file mode 100644
index 000000000000..cf9102420b27
--- /dev/null
+++ b/drivers/usb/typec/tipd/spmi.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SPMI transport for the TI TPS6598x-family USB PD controller driver.
+ *
+ * The Apple M4/T6040 generation carries its four Type-C PD controllers on
+ * Apple SPMI (compatible "usbc,sn201202x,spmi"), not on I2C like the M1/M2
+ * "apple,cd321x" parts. The SN201202x speaks the same TPS6598x logical
+ * register protocol as the I2C parts (VID at 0x00, STATUS at 0x1a, the
+ * DATA1/CMD1 4CC command pair at 0x09/0x08, SSPS system-power-state, ...),
+ * so this file only provides the register access and reuses cd321x_data and
+ * tps6598x_probe_common() from core.c wholesale.
+ *
+ * The SN201202x does NOT expose those logical registers as a flat SPMI
+ * register space, so devm_regmap_init_spmi_ext() (which maps regmap register
+ * N directly onto SPMI extended register N) does not work. The part is paged:
+ * a transfer first *selects* the logical register by writing its number to
+ * SPMI register 0 (SPMI "Register 0 Write"), waits for the select register to
+ * read back the requested number with its busy bit (BIT(7)) cleared, and then
+ * transfers the payload through a data window at SPMI register 0x20, in
+ * SPMI-extended chunks of up to 16 bytes with the window address
+ * auto-incrementing across chunks. This mirrors, byte for byte, the access
+ * that Apple's own AppleHPMARMSPMI::readRegs performs and that our m1n1
+ * bring-up code (t6040_hpm2.c) proved live against this hardware.
+ *
+ * This regmap_bus reproduces that paging so core.c sees an ordinary flat
+ * 8-bit register map (tps6598x_regmap_config).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/of_irq.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/spmi.h>
+
+#include "tps6598x.h"
+
+/* SPMI-visible registers of the SN201202x paging interface. */
+#define TPS_SPMI_REG_SELECT	0x00	/* which logical register is selected */
+#define TPS_SPMI_REG_WINDOW	0x20	/* data window onto the selected reg */
+#define TPS_SPMI_SELECT_BUSY	BIT(7)	/* set while the selection settles */
+
+/* Max payload per SPMI Extended Register Read/Write command. */
+#define TPS_SPMI_CHUNK		16
+
+/* Selection settle: matches the 100 x 1ms budget proven in m1n1. */
+#define TPS_SPMI_SELECT_TRIES	100
+
+static int tps6598x_spmi_select(struct spmi_device *sdev, u8 reg)
+{
+	int ret, i;
+	u8 sel;
+
+	ret = spmi_register_zero_write(sdev, reg);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < TPS_SPMI_SELECT_TRIES; i++) {
+		ret = spmi_ext_register_read(sdev, TPS_SPMI_REG_SELECT, &sel, 1);
+		if (ret)
+			return ret;
+		if (sel == reg)
+			return 0;
+		/* Only the busy-bit-set form of the same register is expected. */
+		if (sel != (reg | TPS_SPMI_SELECT_BUSY))
+			return -EIO;
+		usleep_range(1000, 2000);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int tps6598x_spmi_window_read(struct spmi_device *sdev, u8 *val,
+				     size_t len)
+{
+	u8 addr = TPS_SPMI_REG_WINDOW;
+	int ret;
+
+	while (len) {
+		size_t chunk = min_t(size_t, len, TPS_SPMI_CHUNK);
+
+		ret = spmi_ext_register_read(sdev, addr, val, chunk);
+		if (ret)
+			return ret;
+		addr += chunk;
+		val += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+static int tps6598x_spmi_window_write(struct spmi_device *sdev, const u8 *val,
+				      size_t len)
+{
+	u8 addr = TPS_SPMI_REG_WINDOW;
+	int ret;
+
+	while (len) {
+		size_t chunk = min_t(size_t, len, TPS_SPMI_CHUNK);
+
+		ret = spmi_ext_register_write(sdev, addr, val, chunk);
+		if (ret)
+			return ret;
+		addr += chunk;
+		val += chunk;
+		len -= chunk;
+	}
+
+	return 0;
+}
+
+static int tps6598x_spmi_read(void *context, const void *reg, size_t reg_size,
+			      void *val, size_t val_size)
+{
+	struct spmi_device *sdev = context;
+	int ret;
+
+	if (reg_size != 1)
+		return -EINVAL;
+
+	ret = tps6598x_spmi_select(sdev, *(const u8 *)reg);
+	if (ret)
+		return ret;
+
+	return tps6598x_spmi_window_read(sdev, val, val_size);
+}
+
+static int tps6598x_spmi_gather_write(void *context, const void *reg,
+				      size_t reg_size, const void *val,
+				      size_t val_size)
+{
+	struct spmi_device *sdev = context;
+	int ret;
+
+	if (reg_size != 1)
+		return -EINVAL;
+
+	ret = tps6598x_spmi_select(sdev, *(const u8 *)reg);
+	if (ret)
+		return ret;
+
+	return tps6598x_spmi_window_write(sdev, val, val_size);
+}
+
+static int tps6598x_spmi_write(void *context, const void *data, size_t count)
+{
+	if (count < 1)
+		return -EINVAL;
+
+	/* First byte is the register; the rest is payload. */
+	return tps6598x_spmi_gather_write(context, data, 1,
+					  (const u8 *)data + 1, count - 1);
+}
+
+/*
+ * Keep regmap from splitting a wide logical-register access into multiple bus
+ * calls: each bus call re-selects, so a split would select the wrong (offset)
+ * register. max_raw_read/write are therefore left unset in tps6598x_regmap_config
+ * and the 16-byte SPMI chunking happens inside this bus instead.
+ */
+static const struct regmap_bus tps6598x_spmi_regmap_bus = {
+	.read = tps6598x_spmi_read,
+	.write = tps6598x_spmi_write,
+	.gather_write = tps6598x_spmi_gather_write,
+	.reg_format_endian_default = REGMAP_ENDIAN_NATIVE,
+	.val_format_endian_default = REGMAP_ENDIAN_NATIVE,
+};
+
+static int tps6598x_spmi_probe(struct spmi_device *sdev)
+{
+	const struct tipd_data *data;
+	struct regmap *regmap;
+	int irq;
+
+	data = device_get_match_data(&sdev->dev);
+	if (!data)
+		return -EINVAL;
+
+	/*
+	 * The controller may be in an SPMI low-power state after a warm boot.
+	 * WAKEUP before the first register access mirrors the proven m1n1
+	 * bring-up order (wakeup -> read power state -> SSPS to S0); it is
+	 * harmless if the part is already awake. Reaching S0 itself is left to
+	 * cd321x_data.switch_power_state inside tps6598x_probe_common().
+	 */
+	spmi_command_wakeup(sdev);
+
+	regmap = devm_regmap_init(&sdev->dev, &tps6598x_spmi_regmap_bus, sdev,
+				  &tps6598x_regmap_config);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	irq = of_irq_get(sdev->dev.of_node, 0);
+	if (irq == -EPROBE_DEFER)
+		return irq;
+	if (irq < 0)
+		irq = 0;	/* fall back to polling, like the I2C path */
+
+	return tps6598x_probe_common(&sdev->dev, regmap, irq, data);
+}
+
+static void tps6598x_spmi_remove(struct spmi_device *sdev)
+{
+	tps6598x_remove_common(&sdev->dev);
+}
+
+static const struct of_device_id tps6598x_spmi_of_match[] = {
+	/* M4 / T6040 Type-C PD controllers. */
+	{ .compatible = "usbc,sn201202x,spmi", .data = &cd321x_data },
+	/* apple,cd321x on an SPMI bus, if a DT ever describes it that way. */
+	{ .compatible = "apple,cd321x", .data = &cd321x_data },
