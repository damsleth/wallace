From 7f574a74ea9ea2837ab8a02e5e86bf8bc7bb81d9 Mon Sep 17 00:00:00 2001
From: CJ Damsleth <kim@damsleth.no>
Date: Sat, 31 Oct 2026 21:08:22 +0100
Subject: [PATCH] smp: take the PMGR started-cores bit from the ADT clusters
 table on M4

m1n1 wrote the +0x4 (start) and +0x0 (stop) mask as 1 << (4 * cluster + core).
macOS packs it from the PMGR clusters table (u16 ncores, u16 bitpos per
cluster). On J614s that is E 4@0, P 6@4, P 6@10 (each P cluster has core 5
fused off, acc-harvesting = 1), so the old formula sets bits 8..12 for the
second P cluster where macOS sets 10..14. Use bitpos + core on M4-class chips,
falling back to the old layout when the table is missing, short, or has a
zero bitpos for a non-zero cluster. The per-cluster +0x8 mask is unchanged.
m1n1 notes that the +0x4 bit is needed for IRQs.

Signed-off-by: CJ Damsleth <kim@damsleth.no>
---
 src/smp.c | 37 +++++++++++++++++++++++++++++++++++--
 1 file changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/smp.c b/src/smp.c
index ded5ad5..30eac4f 100644
--- a/src/smp.c
+++ b/src/smp.c
@@ -111,6 +111,39 @@ void smp_secondary_prep_el3(void)
     return;
 }
 
+/*
+ * macOS packs the PMGR started-cores mask (+0x4 on start, +0x0 on stop) from the PMGR
+ * "clusters" table: one u32 per cluster, u16 ncores and u16 bitpos, with cluster i's cores at
+ * bits bitpos..bitpos+ncores-1. That differs from 4 * cluster + core on M4 Pro J614s (E 4@0,
+ * P 6@4, P 6@10), where the old formula set the wrong bits for the second P cluster. Only M4-class
+ * chips (locked sysregs) are verified against the ADT; older chips keep the old layout.
+ */
+static u32 pmgr_core_bit(int cluster, int core)
+{
+    u32 bit = 4 * cluster + core;
+
+    if (cpu_features->apple_sysregs_unlocked)
+        return bit;
+
+    int pmgr = adt_path_offset(adt, "/arm-io/pmgr");
+    u32 len = 0;
+    const u8 *clusters = pmgr >= 0 ? adt_getprop(adt, pmgr, "clusters", &len) : NULL;
+
+    if (!clusters || cluster < 0 || (u32)(cluster + 1) * sizeof(u32) > len)
+        return bit;
+
+    u32 entry;
+    memcpy(&entry, clusters + cluster * sizeof(u32), sizeof(entry));
+    u32 ncores = entry & 0xffff;
+    u32 bitpos = entry >> 16;
+
+    // A zero bitpos is only meaningful for cluster 0
+    if ((!bitpos && cluster) || core >= (int)ncores)
+        return bit;
+
+    return bitpos + core;
+}
+
 static void smp_start_cpu(int index, int die, int cluster, int core, u64 impl, u64 cpu_start_base)
 {
     int i;
@@ -158,7 +191,7 @@ static void smp_start_cpu(int index, int die, int cluster, int core, u64 impl, u
 
     // Some kind of system level startup/status bit
     // Without this, IRQs don't work
-    write32(cpu_start_base + 0x4, 1 << (4 * cluster + core));
+    write32(cpu_start_base + 0x4, 1u << pmgr_core_bit(cluster, core));
 
     // Actually start the core
     write32(cpu_start_base + 0x8 + 4 * cluster, 1 << core);
@@ -195,7 +228,7 @@ static void smp_stop_cpu(int index, int die, int cluster, int core, u64 impl, u6
     cpu_start_base += die * PMGR_DIE_OFFSET;
 
     // Request CPU stop
-    write32(cpu_start_base + 0x0, 1 << (4 * cluster + core));
+    write32(cpu_start_base + 0x0, 1u << pmgr_core_bit(cluster, core));
 
     u64 dsleep = deep_sleep;
     // Put the CPU to sleep
-- 
2.54.0

